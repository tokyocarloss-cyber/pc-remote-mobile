<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
 <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <application
  android:theme="@style/Theme.PCRemote"
  android:label="NEXUS PC Remote"
  android:icon="@drawable/nexus_app_icon"
  android:roundIcon="@drawable/nexus_app_icon"
  android:usesCleartextTraffic="true">
  <activity android:name=".NexusV2Activity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <activity android:name=".NexusActivity" android:exported="false"/>
  <activity android:name=".MainActivity" android:exported="false"/>
  <activity android:name=".ShareReceiverActivity" android:exported="true" android:noHistory="true">
   <intent-filter>
    <action android:name="android.intent.action.SEND"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <data android:mimeType="*/*"/>
   </intent-filter>
   <intent-filter>
    <action android:name="android.intent.action.SEND_MULTIPLE"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <data android:mimeType="*/*"/>
   </intent-filter>
  </activity>
  <service android:name=".EdgeDropService" android:exported="false" android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="NEXUS Drop overlay used only while the user enables drag-to-PC"/>
  </service>
  <service android:name=".PhoneInboxService" android:exported="false" android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Receives files explicitly sent by the paired PC while NEXUS Drop is enabled"/>
  </service>
 </application>
</manifest>
